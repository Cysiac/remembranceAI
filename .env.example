# ============================================================================
# Memorial AI — environment template
# Copy to apps/web/.env.local and apps/worker/.env, then fill from your secret
# manager. Never commit real values.
# ============================================================================

# --- Adaption Lab ----------------------------------------------------------
ADAPTION_API_KEY=

# --- ElevenLabs (voice clone + Conversational AI + TTS) -------------------
ELEVENLABS_API_KEY=

# --- Google Gemini Veo (video) --------------------------------------------
# Get one at https://aistudio.google.com/. Veo 3 is invoked via the Gemini API.
GEMINI_API_KEY=
# Override the Veo model id if needed (e.g. "veo-3.0-generate-preview").
GEMINI_VEO_MODEL=veo-3.0-generate-preview

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# These two are mirrored for the Next.js browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Worker ----------------------------------------------------------------
WORKER_URL=http://localhost:8000
WORKER_PORT=8000
# Shared bearer token between web -> worker. Generate with `openssl rand -hex 32`.
WORKER_SHARED_SECRET=

# --- Demo fallbacks (filled in after the pre-flight Grandma bake) ---------
DEMO_VOICE_ID=
DEMO_AGENT_ID=
DEMO_VIDEO_URL=
