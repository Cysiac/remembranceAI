# Worker-only env. Mirrors the root .env.example.
ADAPTION_API_KEY=
ELEVENLABS_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

WORKER_PORT=8000
WORKER_SHARED_SECRET=

# Comma-separated list of origins allowed to call the worker (the Next.js web app).
WORKER_ALLOWED_ORIGINS=http://localhost:3000
